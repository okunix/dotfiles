general {
    colors = false 
    interval = 5 
    color_good = "#abe047"
    color_bad = "#eb4129"
    color_degraded = "#f6c744"
}

order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "volume master"
order += "memory"
order += "tztime local"

volume master {
    format = "V: %volume"
    format_muted = "V: muted (%volume)"
    device = "pulse:alsa_output.pci-0000_00_1f.3.analog-stereo"
}


wireless _first_ {
        format_up = "W: %essid"
        format_down = ""
}

ethernet _first_ {
        format_up = "E: %ip (%speed)"
        format_down = ""
}

battery all {
        format = "%status %percentage"
        format_down = ""
        format_percentage = "%.00f%s"
}

load {
        format = "%1min"
}

memory {
        format = "M: %used"
}

tztime local {
        format = "%Y %b %d (%a) %H:%M "
}
